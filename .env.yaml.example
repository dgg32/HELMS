# Copy this file to .env.yaml (which is git-ignored) and fill in your values.
#
#   cp .env.yaml.example .env.yaml
#
# IMPORTANT: this is YAML, so use "KEY: value" (colon + space), NOT "KEY=value".
# The .env (dotenv) format uses "=", but .env.yaml uses ":". Mixing them up makes
# the file fail to parse and the app refuses to start.
#
# Priority order: shell env vars > .env.yaml > .env

# ── Models ────────────────────────────────────────────────────────────────────
# "models:" lists every selectable model; the first entry is the default and the
# whole list populates the model-selector dropdown in the UI. Each key is a model
# name; the value dict holds that model's credentials.
#
# For Azure, LLM_ENDPOINT is the bare resource root — NOT the full
# ".../openai/responses?api-version=..." URL the portal shows. The client appends
# the rest of the path itself.
models:
  gpt-5.5:
    LLM_ENDPOINT: "https://<your-resource>.openai.azure.com"
    LLM_API_KEY: "<azure-openai-api-key>"
    LLM_API_VERSION: "2025-04-01-preview"
  gpt-5.4-mini:
    LLM_ENDPOINT: "https://<your-resource>.openai.azure.com"
    LLM_API_KEY: "<azure-openai-api-key>"
    LLM_API_VERSION: "2025-04-01-preview"
  # Non-Azure providers set LLM_PROVIDER explicitly (azure is inferred from
  # LLM_ENDPOINT). Gemini / Anthropic / OpenAI need only an API key.
  gemini-3.1-flash-lite:
    LLM_PROVIDER: gemini
    LLM_API_KEY: "<google-ai-studio-key>"
  mimo-v2.5-pro:
    LLM_PROVIDER: openai_compatible
    LLM_ENDPOINT: "https://opencode.ai/zen/go/v1"
    LLM_API_KEY: "<opencode-go-key>"
    LLM_MODEL: "mimo-v2.5-pro"

# ── LlamaParse — only if using --converter llamaparse (cloud API, no local app) ─
LLAMA_CLOUD_API_KEY: "<llama-cloud-api-key>"

# ── UMLS — only if a schema uses source: umls properties ───────────────────────
UMLS_API_KEY: "<umls-api-key>"

# ── Neo4j — only if using --backend neo4j ──────────────────────────────────────
NEO4J_URI: "neo4j://127.0.0.1:7687"
NEO4J_USERNAME: "neo4j"
NEO4J_PASSWORD: "<neo4j-password>"

# ── Optional tuning ────────────────────────────────────────────────────────────
LLM_TIMEOUT: 120                  # per-call HTTP timeout in seconds
LLM_MAX_COMPLETION_TOKENS: 65536  # reasoning models burn a hidden budget; 65536 recommended
LLM_REASONING_EFFORT: low         # low / medium / high — ignored by non-reasoning models
LOOKUP_CACHE_DB: lookup_cache.db  # SQLite cache for UMLS/GLEIF lookups
